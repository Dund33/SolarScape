{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Windows vcpkg",
      "description": "Configure with vcpkg using the VCPKG_ROOT environment variable.",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "windows-vcpkg-mingw",
      "displayName": "Windows vcpkg MinGW",
      "description": "Configure with vcpkg and the x64 MinGW dynamic triplet.",
      "inherits": "windows-vcpkg",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic"
      }
    },
    {
      "name": "wsl",
      "displayName": "WSL Release",
      "description": "Configure a Release build inside WSL using system packages.",
      "binaryDir": "${sourceDir}/build-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vcpkg",
      "displayName": "Build Windows vcpkg",
      "configurePreset": "windows-vcpkg"
    },
    {
      "name": "windows-vcpkg-mingw",
      "displayName": "Build Windows vcpkg MinGW",
      "configurePreset": "windows-vcpkg-mingw"
    },
    {
      "name": "wsl",
      "displayName": "Build WSL Release",
      "configurePreset": "wsl"
    }
  ]
}
